# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact - leave blank until real details are provided.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_ADDRESS=

# Social - full URLs only. Leave blank if unknown.
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_FACEBOOK=
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_YOUTUBE=
NEXT_PUBLIC_X=

# Database
# neon = PostgreSQL via Neon (DATABASE_URL)
DATA_DRIVER=neon
DATABASE_URL=

# Admin - AUTH_SECRET must be at least 32 characters.
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email notifications
# All three values are required. EMAIL_FROM must use a sender/domain verified by Resend.
RESEND_API_KEY=
INQUIRY_NOTIFY_EMAIL=
EMAIL_FROM=
